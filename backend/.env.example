DATABASE_URL=sqlite:///./society.db

JWT_SECRET_KEY=replace-with-a-secure-secret-generate-via-python-secrets-token_hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Image storage (Cloudinary). Leave blank to use the built-in console fallback.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Max uploaded photo size in megabytes
MAX_UPLOAD_SIZE_MB=5

# Transactional email ("console" logs emails locally, "resend" uses Resend API)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=society-tracker@example.com
